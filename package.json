{
  "name": "vote-app",
  "version": "1.0.0",
  "description": "Allows people to hold polls online",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "npm run check:i18n && vite build",
    "watch": "vite build --watch",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:debug": "npm run build && playwright test --debug",
    "check:i18n": "node scripts/check-i18n.mjs",
    "i18n:baseline": "node scripts/check-i18n.mjs --write-baseline",
    "test:i18n": "node --test tests/js/*.test.mjs",
    "deploy:assets": "node scripts/upload-assets.mjs",
    "screenshots:generate": "node scripts/capture_screenshots.js",
    "test:deploy-assets": "node --test tests/js/upload-assets.test.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "@playwright/test": "^1.57.0",
    "basic-ftp": "^5.3.1",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "intl-messageformat": "^12.1.4"
  }
}
